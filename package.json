{
  "name": "ipfs2foc-monorepo",
  "version": "0.8.1",
  "private": true,
  "description": "Workspace root for ipfs2foc \u2014 the CLI (packages/cli), the redirect relay (packages/relay), the shared core (packages/core), and the browser console (app).",
  "type": "module",
  "packageManager": "pnpm@10.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build"
  },
  "license": "MIT",
  "pnpm": {
    "onlyBuiltDependencies": [
      "node-datachannel"
    ],
    "overrides": {
      "axios": "^1.18.0",
      "fast-uri": "^3.1.5",
      "undici@^8.0.0": "^8.9.0",
      "undici@^7.0.0": "^7.29.0",
      "nanoid@^5.0.0": "^5.1.16",
      "nanoid@^3.0.0": "^3.3.18",
      "brace-expansion@^2.0.0": "^2.1.4",
      "postcss": "^8.5.23",
      "ip-address": "^10.5.0",
      "sharp": "^0.35.0"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.11",
    "typescript": "^6.0.3"
  }
}
